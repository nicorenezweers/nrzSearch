# Kopie dieser Datei als .env anlegen - die wird nicht mit eingecheckt.
# Port, auf dem nrzSearch läuft
PORT=8188
# Wie lange eine einzelne Suchmaschine gebrauchen darf (ms)
ENGINE_TIMEOUT=12000
# Geokodierung für die Ortskarte (OpenStreetMap)
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Die eigene SearXNG-Instanz - eine oder mehrere Adressen, mit Komma getrennt.
# Die erste, die antwortet, wird genommen.
SXNG_URL=http://localhost:8080
# Die Konfiguration der Module (Instant Answers)
# MODULE_CONFIG=module.json
# Die KI (Übersicht mit KI, KI-Modus) über OpenRouter. Der Schlüssel kommt
# hierher oder in die Datei OPENROUTER_KEY_FILE - fehlt er, fragt der
# KI-Modus einmal danach. Nie einchecken!
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_KEY_FILE=openrouter.key
# OPENROUTER_MODEL=openrouter/free
